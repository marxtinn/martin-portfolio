---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import portrait from '../assets/portrait.jpg';
import { profile } from '../data/site';

const headline = 'Interfaces that stay easy to change.';
const words = headline.split(' ');
---
<section id="top" class="relative mx-auto grid min-h-[100dvh] max-w-6xl items-center gap-12 px-4 pt-28 pb-16 sm:px-6 lg:grid-cols-12 lg:gap-10 lg:pt-24">
  <div class="lg:col-span-7">
    <p class="fade-in mb-7 inline-flex items-center gap-2.5 rounded-full border border-line bg-elevated/60 py-1.5 pr-4 pl-3 text-sm text-muted" style="--delay:0s">
      <span class="relative flex size-2" aria-hidden="true">
        <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-60 motion-reduce:animate-none"></span>
        <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
      </span>
      {profile.availability}
    </p>

    <h1 class="text-[2.75rem] leading-[1.02] font-semibold tracking-[-0.045em] text-balance text-ink sm:text-6xl lg:text-[4.4rem]">
      {words.map((w, i) => (
        <>
          <span class="rise" style={`--i:${i}`}>{w}</span>{' '}
        </>
      ))}
    </h1>

    <p class="fade-in mt-7 max-w-[34rem] text-lg leading-relaxed text-pretty text-muted" style="--delay:0.45s">
      I'm Martin, a React, Vue and TypeScript engineer. Most recently the lead frontend contributor at Tesserac AI.
    </p>

    <div class="fade-in mt-10 flex flex-wrap items-center gap-3" style="--delay:0.6s">
      <a
        href="#work"
        class="group inline-flex h-12 items-center gap-2 rounded-full bg-accent px-6 font-medium whitespace-nowrap text-on-accent shadow-[0_10px_30px_-10px_var(--accent)] transition duration-300 ease-out-expo hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]"
      >
        View work
        <Icon name="ph:arrow-right" size={18} class="transition-transform duration-300 group-hover:translate-x-1" />
      </a>
      <a
        href={`mailto:${profile.email}`}
        class="inline-flex h-12 items-center gap-2 rounded-full border border-line bg-elevated px-6 font-medium whitespace-nowrap text-ink transition duration-300 hover:border-ink/30 active:scale-[0.98]"
      >
        <Icon name="ph:envelope-simple" size={18} />
        Email me
      </a>
    </div>
  </div>

  <div class="lg:col-span-5">
    <div class="tilt mx-auto max-w-[26rem] [perspective:1200px] lg:mr-0" data-tilt>
      <div class="tilt-inner relative transition-transform duration-500 ease-out-expo will-change-transform">
        <Image
          src={portrait}
          alt="Martin Butarbutar sitting on a hilltop above a lake at dusk"
          widths={[320, 460]}
          sizes="(min-width: 1024px) 26rem, 90vw"
          loading="eager"
          fetchpriority="high"
          class="portrait-in aspect-[4/5] w-full rounded-[var(--radius-tile)] object-cover object-[58%_50%] shadow-[var(--shadow)]"
        />
        <div class="pointer-events-none absolute inset-0 rounded-[var(--radius-tile)] ring-1 ring-ink/10 ring-inset"></div>
      </div>
    </div>
  </div>
</section>

<script>
  // Subtle 3D tilt that follows the pointer. Fine pointers only, off for reduced motion.
  const wrap = document.querySelector<HTMLElement>('[data-tilt]');
  const inner = wrap?.querySelector<HTMLElement>('.tilt-inner');
  const canTilt = matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)').matches;

  if (wrap && inner && canTilt) {
    let frame = 0;
    wrap.addEventListener('pointermove', (e) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const r = wrap.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        inner.style.transform = `rotateY(${x * 8}deg) rotateX(${-y * 8}deg) scale(1.015)`;
      });
    });
    wrap.addEventListener('pointerleave', () => {
      cancelAnimationFrame(frame);
      inner.style.transform = '';
    });
  }
</script>
