---
import SectionLabel from './SectionLabel.astro';
import { skills } from '../data/site';
---
<section id="stack" aria-labelledby="stack-title" class="mx-auto max-w-[1400px] px-5 pb-24 md:px-8 md:pb-36">
  <SectionLabel label="Stack" />
  <div class="grid gap-14 lg:grid-cols-2 lg:gap-8">
    <div data-reveal>
      <h2 id="stack-title" class="display text-[clamp(2.75rem,5.4vw,4.75rem)] text-ink">TypeScript first.</h2>
      <p class="mt-6 max-w-[26rem] text-[15px] leading-relaxed text-muted">
        Comfortable across React and Vue, with working experience in Node.js, Go and Python backends.
      </p>
    </div>

    <div class="grid gap-x-8 gap-y-12 sm:grid-cols-2">
      {skills.map((s, i) => (
        <div data-reveal style={`--d:${i % 2}`} class="border-t border-line pt-5">
          <h3 class="text-xs font-normal text-subtle">{s.group}</h3>
          <ul class="mt-4 grid gap-1.5">
            {s.items.map((item) => <li class="text-lg tracking-[-0.01em] text-ink">{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
