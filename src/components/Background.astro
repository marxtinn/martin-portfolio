---
import { Image } from 'astro:assets';
import SectionLabel from './SectionLabel.astro';
import portrait from '../assets/portrait.webp';
import { education, languages, profile } from '../data/site';
---
<section aria-labelledby="about-title" class="mx-auto max-w-[1400px] px-5 pb-24 md:px-8 md:pb-36">
  <SectionLabel label="About" />
  <div class="grid gap-14 lg:grid-cols-2 lg:gap-8">
    <div data-reveal class="lg:pr-16">
      <Image
        src={portrait}
        alt="Martin Butarbutar sitting on a hilltop above a lake at dusk"
        widths={[480, 800, 1100]}
        sizes="(min-width: 1024px) 34rem, 90vw"
        class="aspect-[4/5] w-full max-w-[34rem] object-cover object-[55%_60%] grayscale transition duration-1000 ease-out-expo hover:grayscale-0"
      />
    </div>

    <div>
      <h2 id="about-title" data-reveal class="display text-[clamp(2.25rem,4.2vw,3.75rem)] text-ink">
        Trained as a mechanical engineer. Retrained in full-stack web development.
      </h2>
      <p data-reveal class="mt-6 max-w-[30rem] text-[15px] leading-relaxed text-muted">
        I care most about components that are easy to maintain and UI that works for everyone. I use AI coding tools such as Claude Code daily.
      </p>

      <dl class="mt-16 grid gap-x-8 gap-y-10 sm:grid-cols-2">
        <div data-reveal class="border-t border-line pt-5 sm:col-span-2">
          <dt class="text-xs text-subtle">Education</dt>
          {education.map((e) => (
            <dd class="mt-4 flex flex-wrap items-baseline justify-between gap-x-6">
              <span class="text-lg tracking-[-0.01em] text-ink">{e.school}</span>
              <span class="text-sm text-subtle">{e.detail}, {e.note}</span>
            </dd>
          ))}
        </div>
        <div data-reveal class="border-t border-line pt-5">
          <dt class="text-xs text-subtle">Languages</dt>
          {languages.map((l) => (
            <dd class="mt-2 text-lg tracking-[-0.01em] text-ink">
              {l.name} <span class="text-sm text-subtle">{l.level}</span>
            </dd>
          ))}
        </div>
        <div data-reveal style="--d:1" class="border-t border-line pt-5">
          <dt class="text-xs text-subtle">Based in</dt>
          <dd class="mt-2 text-lg tracking-[-0.01em] text-ink">{profile.location}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>
