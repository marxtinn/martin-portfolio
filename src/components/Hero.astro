---
import Icon from './Icon.astro';
import { profile } from '../data/site';

// Each word rises out of its own mask; text still wraps naturally on small screens.
const lines = [
  ['Interfaces', 'that', 'stay'],
  ['easy', 'to', 'change.'],
];
---

<section id="top" class="relative isolate min-h-[100dvh] overflow-hidden">
  <!-- Header switches to its solid state once this 80px marker scrolls out of view. -->
  <div data-scroll-sentinel class="pointer-events-none absolute top-20 left-0 h-px w-px" aria-hidden="true">
  </div>
  <!-- On tall phone screens the chrome sits below the copy instead of behind it. -->
  <canvas
    data-chrome
    class="canvas-in peer absolute inset-x-0 top-[44%] bottom-0 -z-10 h-[56%] w-full data-[fallback=true]:invisible md:top-0 md:h-full"
    aria-hidden="true"></canvas>
  <!-- Still frame of the shader, shown only if WebGL2 is unavailable or the GPU context is lost. -->
  <img
    src="/chrome-light.webp"
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    class="absolute inset-x-0 top-[44%] -z-10 hidden h-[56%] w-full object-cover object-left-bottom peer-data-[fallback=true]:block md:top-0 md:h-full dark:peer-data-[fallback=true]:hidden"
  />
  <img
    src="/chrome-dark.webp"
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    class="absolute inset-x-0 top-[44%] -z-10 hidden h-[56%] w-full object-cover object-left-bottom md:top-0 md:h-full dark:peer-data-[fallback=true]:block"
  />

  <div class="mx-auto max-w-[1400px] px-5 pt-28 md:px-8 md:pt-32">
    <h1 class="display text-[clamp(2.6rem,6vw,5.25rem)] text-ink">
      {
        lines.map((words, li) => (
          <>
            {words.map((w, wi) => (
              <>
                <span class="line-mask inline-block align-bottom">
                  <span class="line-rise" style={`--i:${li * 2 + wi * 0.35}`}>
                    {w}
                  </span>
                </span>{' '}
              </>
            ))}
            {li === 0 && <br class="max-md:hidden" />}
          </>
        ))
      }
    </h1>

    <p class="fade-in mt-7 max-w-[30rem] text-[15px] leading-relaxed text-muted" style="--delay:0.25s">
      I'm Martin, a React & TypeScript engineer based in Jakarta. Most recently one of the lead frontend
      contributors at Tesserac AI.
    </p>

    <div class="fade-in mt-10 flex flex-wrap gap-x-10 gap-y-4 text-[15px] text-ink" style="--delay:0.35s">
      <a href="#work" class="link-line">View work</a>
      <a href={`mailto:${profile.email}`} class="link-line"
        >Email me <Icon name="ph:arrow-up-right" size={14} /></a
      >
    </div>
  </div>
</section>

<script>
  import { mountChrome } from '../scripts/chrome';
  const canvas = document.querySelector<HTMLCanvasElement>('[data-chrome]');
  // Compile the shader after first paint so it never competes with the headline.
  const idle = window.requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 1));
  if (canvas) idle(() => mountChrome(canvas), { timeout: 600 });
</script>
