---
import SectionLabel from './SectionLabel.astro';
import { experience } from '../data/site';
---
<section id="experience" aria-labelledby="experience-title" class="mx-auto max-w-[1400px] px-5 pt-24 pb-24 md:px-8 md:pb-36">
  <SectionLabel label="Experience" />
  <h2 id="experience-title" data-reveal class="display max-w-[16ch] text-[clamp(2.75rem,5.4vw,4.75rem)] text-ink">
    Two years of product frontends.
  </h2>

  <ol class="mt-16 md:mt-24">
    {experience.map((job, i) => (
      <li data-reveal style={`--d:${i}`} class="grid gap-6 border-t border-line py-10 lg:grid-cols-2 lg:gap-8 lg:py-12">
        <div>
          <h3 class="text-3xl tracking-[-0.02em] text-ink md:text-4xl">{job.company}</h3>
          <p class="mt-3 text-sm text-subtle">{job.period}</p>
        </div>
        <div>
          <p class="text-xl tracking-[-0.01em] text-ink">{job.role}</p>
          <p class="mt-1 text-sm text-subtle">{job.place}</p>
          <p class="mt-5 max-w-[34rem] text-[15px] leading-relaxed text-muted">{job.about}</p>
          <ul class="mt-6 grid max-w-[34rem] gap-2 text-[15px] leading-relaxed text-ink">
            {job.highlights.map((h) => <li>{h}</li>)}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</section>
