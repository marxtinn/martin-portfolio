---
import Icon from './Icon.astro';
import SectionLabel from './SectionLabel.astro';
import { principles } from '../data/site';
---
<!-- The one deliberate theme flip on the page. -->
<section data-band aria-labelledby="principles-title" class="relative isolate overflow-hidden bg-band text-band-ink">
  <!-- Iridescent light streaks: CSS-only, a slow turn. -->
  <div class="streaks pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>

  <div class="mx-auto max-w-[1400px] px-5 pt-24 pb-24 md:px-8 md:pb-32">
    <SectionLabel label="Approach" band />
    <h2 id="principles-title" data-reveal class="display max-w-[20ch] text-[clamp(2.4rem,4.8vw,4.4rem)]">
      Code the next engineer can change. Tested before it ships.
    </h2>

    <ul class="mt-24 grid gap-14 md:mt-36 md:grid-cols-3 md:gap-8">
      {principles.map((p, i) => (
        <li data-reveal style={`--d:${i}`}>
          <Icon name={p.icon} size={64} class="text-band-ink" />
          <h3 class="mt-8 border-t border-band-line pt-6 text-2xl tracking-[-0.02em] md:text-[1.75rem]">{p.title}</h3>
          <p class="mt-3 max-w-[24rem] text-sm leading-relaxed text-band-muted">{p.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .streaks span {
    position: absolute;
    left: 50%;
    top: 14%;
    width: 46rem;
    height: 12rem;
    border-radius: 50%;
    border: 3px solid transparent;
    background:
      conic-gradient(from 0deg, transparent 0 55%, rgb(255 190 150 / 0.9) 62%, rgb(255 255 255) 66%, rgb(150 190 255 / 0.9) 70%, transparent 78%) border-box;
    -webkit-mask: linear-gradient(#000 0 0) padding-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    filter: blur(1.2px) drop-shadow(0 0 14px rgb(255 200 220 / 0.55)) drop-shadow(0 0 30px rgb(160 200 255 / 0.35));
    opacity: 0.95;
    transform: translateX(-50%) rotate(-14deg);
  }
  .streaks span:nth-child(2) { width: 30rem; height: 7rem; top: 22%; opacity: 0.7; transform: translateX(-30%) rotate(18deg); }
  .streaks span:nth-child(3) { width: 60rem; height: 18rem; top: 6%; opacity: 0.45; transform: translateX(-62%) rotate(-4deg); }

  @media (prefers-reduced-motion: no-preference) {
    .streaks span { animation: turn 22s linear infinite; }
    .streaks span:nth-child(2) { animation-duration: 30s; animation-direction: reverse; }
    .streaks span:nth-child(3) { animation-duration: 40s; }
  }
  @keyframes turn {
    to { rotate: 360deg; }
  }
</style>
