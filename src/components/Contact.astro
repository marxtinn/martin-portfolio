---
import Icon from './Icon.astro';
import SectionLabel from './SectionLabel.astro';
import { profile } from '../data/site';

const links = [
  { href: `mailto:${profile.email}`, label: 'Email', newTab: false },
  { href: profile.linkedin, label: 'LinkedIn', newTab: true },
  { href: profile.github, label: 'GitHub', newTab: true },
  { href: profile.resume, label: 'Resume', newTab: true },
];
---
<section id="contact" aria-labelledby="contact-title" class="mx-auto max-w-[1400px] px-5 pt-8 md:px-8">
  <SectionLabel label="Contact" />
  <h2 id="contact-title" data-reveal class="display max-w-[18ch] text-[clamp(2.6rem,5.6vw,5rem)] text-ink">
    Hiring for a frontend role? I'd like to hear about it.
  </h2>

  <div class="mt-20 grid gap-14 border-t border-line pt-10 lg:grid-cols-2 lg:gap-8">
    <ul data-reveal class="grid gap-1">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            target={l.newTab ? '_blank' : undefined}
            rel={l.newTab ? 'noopener noreferrer' : undefined}
            class="group inline-flex items-center gap-3 text-4xl tracking-[-0.025em] text-ink md:text-5xl"
          >
            <span class="transition-transform duration-500 ease-out-expo group-hover:translate-x-2">{l.label}</span>
            {l.newTab && <span class="sr-only"> (opens in a new tab)</span>}
            <Icon name="ph:arrow-up-right" size={22} class="opacity-0 transition duration-500 ease-out-expo group-hover:opacity-100" />
          </a>
        </li>
      ))}
    </ul>

    <div data-reveal style="--d:1" class="grid content-start gap-8 text-sm">
      <div>
        <p class="text-xs text-subtle">Email</p>
        <button type="button" data-copy={profile.email} class="mt-2 inline-flex items-center gap-2 text-lg text-ink hover:opacity-60">
          <span data-copy-label>{profile.email}</span>
          <Icon name="ph:copy" size={16} />
        </button>
        <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
      </div>
      <div>
        <p class="text-xs text-subtle">Availability</p>
        <p class="mt-2 text-lg text-ink">{profile.availability}</p>
      </div>
    </div>
  </div>

  <footer class="mt-24 border-t border-line pt-6">
    <div class="flex flex-wrap justify-between gap-4 text-xs text-subtle">
      <p>© {new Date().getFullYear()} {profile.name}</p>
      <p>Built with Astro and Tailwind CSS</p>
    </div>

    <!-- Oversized wordmark, split around a chrome mark. -->
    <div class="mt-16 flex items-end justify-between gap-4 pb-6 md:mt-24" aria-hidden="true">
      <span class="display text-[clamp(2.25rem,9.6vw,9.5rem)] leading-[0.8] text-ink">Martin</span>
      <span class="chrome mb-[1.5vw] inline-block h-[clamp(1rem,2.6vw,2.6rem)] w-[clamp(2rem,5.4vw,5.4rem)] shrink-0 -rotate-12 rounded-full"></span>
      <span class="display text-[clamp(2.25rem,9.6vw,9.5rem)] leading-[0.8] text-ink">Butarbutar</span>
    </div>
  </footer>
</section>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const label = btn?.querySelector('[data-copy-label]');
  const status = document.querySelector('[data-copy-status]');
  let timer = 0;

  btn?.addEventListener('click', async () => {
    const email = btn.dataset.copy!;
    try {
      await navigator.clipboard.writeText(email);
      if (label) label.textContent = 'Copied to clipboard';
      if (status) status.textContent = 'Email address copied';
    } catch {
      if (label) label.textContent = 'Copy failed, select it manually';
    }
    clearTimeout(timer);
    timer = window.setTimeout(() => {
      if (label) label.textContent = email;
      if (status) status.textContent = '';
    }, 2000);
  });
</script>
