---
// Renders Phosphor icons as inline SVG at build time (zero client JS).
import { getIconData, iconToSVG, iconToHTML, replaceIDs } from '@iconify/utils';
import ph from '@iconify-json/ph/icons.json';
import type { IconifyJSON } from '@iconify/types';

interface Props {
  name: string; // "ph:arrow-right"
  size?: number | string;
  class?: string;
  label?: string;
}

const { name, size = '1em', class: className, label } = Astro.props;
const [prefix, icon] = name.split(':');
const sets: Record<string, IconifyJSON> = { ph: ph as IconifyJSON };
const data = sets[prefix] && getIconData(sets[prefix], icon);
if (!data) throw new Error(`Unknown icon: ${name}`);

const { attributes, body } = iconToSVG(data, { height: String(size) });
const svg = iconToHTML(replaceIDs(body), {
  ...attributes,
  fill: 'currentColor',
  class: className ?? '',
  ...(label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' }),
});
---
<Fragment set:html={svg} />
