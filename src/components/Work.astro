---
import Icon from './Icon.astro';
import SectionLabel from './SectionLabel.astro';
import { projects } from '../data/site';

// Group projects by company, keeping data order.
const groups = projects.reduce<{ org: string; period: string; items: typeof projects }[]>((acc, p) => {
  const g = acc.find((x) => x.org === p.org);
  if (g) g.items.push(p);
  else acc.push({ org: p.org, period: p.period, items: [p] });
  return acc;
}, []);
---
<section id="work" aria-labelledby="work-title" class="mx-auto max-w-[1400px] px-5 pb-24 md:px-8 md:pb-36">
  <SectionLabel label="Selected work" />

  <div class="grid gap-14 lg:grid-cols-2 lg:gap-8">
    <div>
      <div class="lg:sticky lg:top-28" data-reveal>
        <h2 id="work-title" class="display text-[clamp(2.75rem,5.4vw,4.75rem)] text-ink">Product work</h2>
        <p class="mt-6 max-w-[26rem] text-[15px] leading-relaxed text-muted">
          Frontends and integrations for accounting, legal and AI teams. Select a project for the full details.
        </p>
      </div>
    </div>

    <div class="grid gap-16">
      {groups.map((g) => (
        <div>
          <p data-reveal class="mb-2 text-xs text-subtle">{g.org}, {g.period}</p>
          <ul>
            {g.items.map((p, i) => (
              <li data-reveal style={`--d:${i % 3}`} class="border-t border-line">
                <button
                  type="button"
                  data-open={p.id}
                  aria-haspopup="dialog"
                  class="group grid w-full gap-3 py-7 text-left md:py-8"
                >
                  <span class="flex items-start justify-between gap-6">
                    <span class="flex flex-wrap items-center gap-3">
                      <span class="text-[1.65rem] leading-tight font-medium tracking-[-0.02em] text-ink transition-transform duration-500 ease-out-expo group-hover:translate-x-2 md:text-3xl">
                        {p.title}
                      </span>
                      {p.badge && <span class="bg-ink px-2 py-1 text-[11px] leading-none text-bg">{p.badge}</span>}
                    </span>
                    <Icon
                      name="ph:arrow-up-right"
                      size={18}
                      class="mt-2 shrink-0 text-ink opacity-30 transition duration-500 ease-out-expo group-hover:opacity-100 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                    />
                  </span>
                  <span class="max-w-[30rem] text-sm leading-relaxed text-muted">{p.summary}</span>
                  <span class="text-xs text-subtle">{p.stack.join(', ')}</span>
                </button>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  {projects.map((p) => (
    <dialog
      id={`dlg-${p.id}`}
      aria-labelledby={`dlg-${p.id}-title`}
      class="project-dialog fixed m-auto max-h-[min(88dvh,48rem)] w-[min(46rem,calc(100vw-2rem))] overflow-y-auto border border-line bg-bg p-0 text-ink shadow-[0_30px_80px_-30px_rgb(0_0_0/0.45)]"
    >
      <div class="sticky top-0 z-10 flex items-center justify-between gap-4 border-b border-line bg-bg px-6 py-4 md:px-10">
        <p class="text-xs text-subtle">{p.org}, {p.period}</p>
        <button type="button" data-close class="inline-flex items-center gap-1.5 text-sm text-ink hover:opacity-60">
          Close <Icon name="ph:x" size={14} />
        </button>
      </div>
      <div class="px-6 pt-8 pb-10 md:px-10 md:pt-10 md:pb-12">
        <h3 id={`dlg-${p.id}-title`} class="display text-4xl text-balance md:text-5xl">{p.title}</h3>
        <p class="mt-5 max-w-[56ch] text-[15px] leading-relaxed text-muted">{p.summary}</p>
        <p class="mt-4 text-xs text-subtle">{p.stack.join(', ')}</p>
        <ol class="mt-10">
          {p.points.map((pt, i) => (
            <li class="grid grid-cols-[2.25rem_1fr] border-t border-line py-5 text-[15px] leading-relaxed">
              <span class="text-xs text-subtle tabular-nums">{String(i + 1).padStart(2, '0')}</span>
              <span>{pt}</span>
            </li>
          ))}
        </ol>
      </div>
    </dialog>
  ))}
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((btn) => {
    const dlg = document.getElementById(`dlg-${btn.dataset.open}`) as HTMLDialogElement | null;
    if (!dlg) return;
    btn.addEventListener('click', () => {
      dlg.showModal();
      document.documentElement.style.overflow = 'hidden';
    });
    dlg.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      btn.focus({ preventScroll: true });
    });
    dlg.querySelector('[data-close]')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => {
      if (e.target !== dlg) return;
      const r = dlg.getBoundingClientRect();
      const inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
      if (!inside) dlg.close();
    });
  });
</script>
