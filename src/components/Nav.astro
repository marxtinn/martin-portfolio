---
import Icon from './Icon.astro';

const links = [
  { href: '#work', label: 'Work' },
  { href: '#experience', label: 'Experience' },
  { href: '#stack', label: 'Stack' },
  { href: '#contact', label: 'Contact' },
];
---
<header class="fixed inset-x-0 top-0 z-50 px-4 pt-4 sm:px-6">
  <nav
    aria-label="Primary"
    class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 rounded-full border border-line/80 bg-bg/70 py-2 pr-2 pl-5 shadow-[0_8px_30px_-12px_rgb(0_0_0/0.18)] backdrop-blur-xl backdrop-saturate-150"
  >
    <a href="#top" class="font-semibold tracking-tight text-ink" aria-label="Martin Butarbutar, back to top">
      Martin<span class="text-accent">.</span>
    </a>

    <ul class="hidden items-center gap-1 md:flex" data-navlinks>
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            data-nav={l.href.slice(1)}
            class="relative rounded-full px-4 py-2 text-sm text-muted transition-colors duration-300 hover:text-ink aria-[current=true]:bg-surface aria-[current=true]:text-ink"
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-1.5">
      <button
        type="button"
        data-theme-toggle
        class="grid size-10 place-items-center rounded-full text-muted transition hover:bg-surface hover:text-ink active:scale-95"
        aria-label="Toggle color theme"
      >
        <Icon name="ph:moon" size={18} class="dark:hidden" />
        <Icon name="ph:sun" size={18} class="hidden dark:block" />
      </button>
      <a
        href="/Martin-Butarbutar-Resume.pdf"
        class="hidden h-10 items-center gap-2 rounded-full bg-ink px-4 text-sm font-medium whitespace-nowrap text-bg transition hover:opacity-90 active:scale-[0.98] sm:inline-flex"
      >
        Resume <Icon name="ph:download-simple" size={15} />
      </a>
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid size-10 place-items-center rounded-full text-ink transition hover:bg-surface active:scale-95 md:hidden"
        aria-label="Open menu"
      >
        <Icon name="ph:list" size={20} />
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    hidden
    class="mx-auto mt-2 max-w-6xl rounded-[var(--radius-tile)] border border-line bg-bg/95 p-2 backdrop-blur-xl md:hidden"
  >
    <ul>
      {links.map((l) => (
        <li>
          <a href={l.href} class="block rounded-full px-4 py-3 text-ink hover:bg-surface">{l.label}</a>
        </li>
      ))}
      <li class="sm:hidden">
        <a href="/Martin-Butarbutar-Resume.pdf" class="block rounded-full px-4 py-3 text-ink hover:bg-surface">Resume (PDF)</a>
      </li>
    </ul>
  </div>
</header>

<script>
  const root = document.documentElement;

  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    const apply = () => {
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
    };
    // Crossfade the whole page when the browser supports view transitions.
    const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
    if (doc.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) doc.startViewTransition(apply);
    else apply();
  });

  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  const setMenu = (open: boolean) => {
    if (!menu || !menuBtn) return;
    menu.hidden = !open;
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  menuBtn?.addEventListener('click', () => setMenu(Boolean(menu?.hidden)));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setMenu(false);
  });

  // Highlight the nav link for the section currently in view.
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav]');
  const visible = new Set<string>();
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) visible.add(entry.target.id);
        else visible.delete(entry.target.id);
      }
      // First section (in page order) crossing the middle band wins; none means no highlight.
      const active = [...navLinks].find((a) => visible.has(a.dataset.nav!))?.dataset.nav;
      navLinks.forEach((a) => a.setAttribute('aria-current', String(a.dataset.nav === active)));
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  navLinks.forEach((a) => {
    const section = document.getElementById(a.dataset.nav!);
    if (section) observer.observe(section);
  });
</script>
