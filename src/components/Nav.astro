---
import Icon from './Icon.astro';
import { profile } from '../data/site';

const links = [
  { href: '#work', label: 'Work' },
  { href: '#experience', label: 'Experience' },
  { href: '#stack', label: 'Stack' },
  { href: '#contact', label: 'Contact' },
];
---
<header
  data-header
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-500 data-[scrolled=true]:border-line data-[scrolled=true]:bg-bg/85 data-[scrolled=true]:backdrop-blur-md"
>
  <nav aria-label="Primary" class="mx-auto flex h-16 max-w-[1400px] items-center justify-between px-5 md:grid md:grid-cols-[1fr_auto_1fr] md:px-8">
    <a href="#top" class="flex items-center gap-2.5 text-sm font-medium whitespace-nowrap text-ink" aria-label="Martin Butarbutar, back to top">
      <span class="chrome inline-block h-3.5 w-6 -rotate-12 rounded-full" aria-hidden="true"></span>
      Martin Butarbutar
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            data-nav={l.href.slice(1)}
            class="text-sm text-subtle transition-colors duration-300 hover:text-ink aria-[current=true]:text-ink"
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center justify-end gap-5">
      <a href={profile.resume} target="_blank" rel="noopener" class="hidden text-sm text-ink sm:inline-flex sm:items-center sm:gap-1.5">
        Resume <Icon name="ph:arrow-up-right" size={13} /><span class="sr-only"> (opens in a new tab)</span>
      </a>
      <button
        type="button"
        data-theme-toggle
        class="grid size-9 place-items-center text-ink transition-opacity hover:opacity-60"
        aria-label="Toggle color theme"
      >
        <Icon name="ph:moon" size={17} class="dark:hidden" />
        <Icon name="ph:sun" size={17} class="hidden dark:block" />
      </button>
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="text-sm text-ink md:hidden"
      >
        Menu
      </button>
    </div>
  </nav>

  <div id="mobile-menu" hidden class="border-t border-line bg-bg px-5 pt-4 pb-8 md:hidden">
    <ul>
      {links.map((l) => (
        <li class="border-b border-line">
          <a href={l.href} class="block py-4 text-3xl font-medium tracking-tight text-ink">{l.label}</a>
        </li>
      ))}
      <li>
        <a href={profile.resume} target="_blank" rel="noopener" class="block py-4 text-3xl font-medium tracking-tight text-ink">
          Resume<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>('[data-header]');

  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    const apply = () => {
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
      window.dispatchEvent(new CustomEvent('themechange'));
    };
    const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
    if (doc.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) doc.startViewTransition(apply);
    else apply();
  });

  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  const setMenu = (open: boolean) => {
    if (!menu || !menuBtn) return;
    menu.hidden = !open;
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.textContent = open ? 'Close' : 'Menu';
    header?.setAttribute('data-menu', String(open));
    if (open) header?.setAttribute('data-scrolled', 'true');
  };
  menuBtn?.addEventListener('click', () => setMenu(Boolean(menu?.hidden)));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setMenu(false);
  });

  // Header gains a backdrop once the page has scrolled past the top.
  const sentinel = document.querySelector('[data-scroll-sentinel]');
  if (sentinel && header) {
    new IntersectionObserver(([entry]) => {
      if (header.dataset.menu === 'true') return;
      header.dataset.scrolled = String(!entry.isIntersecting);
    }).observe(sentinel);
  }

  // While the dark band passes under the header, the header switches to the dark palette.
  const band = document.querySelector('[data-band]');
  if (band && header) {
    let bandObserver: IntersectionObserver | undefined;
    const watchBand = () => {
      bandObserver?.disconnect();
      bandObserver = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) header.dataset.theme = 'dark';
        else delete header.dataset.theme;
      }, { rootMargin: `0px 0px -${Math.max(window.innerHeight - 40, 0)}px 0px` });
      bandObserver.observe(band);
    };
    watchBand();
    window.addEventListener('resize', watchBand, { passive: true });
  }

  // Current section indicator.
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav]');
  const visible = new Set<string>();
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) visible.add(entry.target.id);
        else visible.delete(entry.target.id);
      }
      const active = [...navLinks].find((a) => visible.has(a.dataset.nav!))?.dataset.nav;
      navLinks.forEach((a) => a.setAttribute('aria-current', String(a.dataset.nav === active)));
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  navLinks.forEach((a) => {
    const section = document.getElementById(a.dataset.nav!);
    if (section) observer.observe(section);
  });
</script>
